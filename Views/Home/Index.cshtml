@{
    ViewData["Title"] = "Characters in The Binding of Isaac";
}

<div class="p-5 mb-4 bg-body-tertiary rounded-3">
    <h1 class="display-4">Isaac Characters</h1>
    <p class="lead">
        Every character in The Binding of Isaac! Their names, their stats, and their gimmicks! Come on in and add a modded character if you wish!
    </p>
    <a asp-controller="Characters" asp-action="Index" class="btn btn-primary btn-lg">Browse the Characters</a>
    <a asp-controller="Gimmicks" asp-action="Index" class="btn btn-outline-light btn-lg ms-2">Start from a dish</a>
</div>

@section Scripts {
<script src="https://jgrissom.github.io/dotnet-web-dev/week-09/homework-checks.js"></script>}