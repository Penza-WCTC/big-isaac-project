@{
    ViewData["Title"] = "Characters in The Binding of Isaac";
}

<div class="p-5 mb-4 bg-body-tertiary rounded-3">
    <h1 class="display-4">Isaac Characters</h1>
    <p class="lead">
        Every character in The Binding of Isaac is listed here! Their names, their stats, and their gimmicks! Come on in and add a
        modded character if you wish!
    </p>
    <a asp-controller="Characters" asp-action="Index" class="btn btn-primary btn-lg">Browse the Characters</a>
</div>
    <h3>About The Binding of Isaac</h3>
    <p>
        The Binding of Isaac: Rebirth is a randomly generated action RPG shooter with heavy Rogue-like elements.
        Following Isaac on his journey players will find bizarre treasures that change Isaac’s form giving him super
        human abilities and enabling him to fight off droves of mysterious creatures, discover secrets and fight his way
        to safety.
    </p>
    <p>
        There are thirty two characters in The Binding of Isaac: Rebirth, and six hundred fourty one achievements. Each
        character has their own unique gimmick, and their own stats!
    </p>


@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-11/homework-checks.js"></script>
}