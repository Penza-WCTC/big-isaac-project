<h1>The Binding of Isaac Characters</h1>

@model Character
@{
    ViewData["Title"] = "Character Details";
}

<p class="text-muted">@Model.Name details</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Health</th>
            <th>Speed</th>
            <th>Damage</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <partial name="_CharacterRow" model="Model" />
        </tr>
        }
    </tbody>
</table>