@model Character
@{
    ViewData["Title"] = "Edit a Character";
}

<h1>Edit a Character</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Health" class="form-label"></label>
        <input asp-for="Health" class="form-control" />
        <span asp-validation-for="Health" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Speed" class="form-label"></label>
        <input asp-for="Speed" class="form-control" />
        <span asp-validation-for="Speed" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Damage" class="form-label"></label>
        <input asp-for="Damage" class="form-control" />
        <span asp-validation-for="Damage" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FavoriteDetails" class="form-label"></label>
        <input asp-for="FavoriteDetails" class="form-control" />
        <span asp-validation-for="FavoriteDetails" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}