<h1>The Binding of Isaac Characters</h1>

@model List<Character>
@{
    ViewData["Title"] = "Characters";
}

<p class="text-muted">@Model.Count characters in The Binding of Isaac.</p>

<a asp-action="Create" class="btn btn-primary mb-4">＋ Add a Modded Character</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Health</th>
            <th>Speed</th>
            <th>Damage</th>
            <th>Details Link</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var character in Model)
        {
            <tr>
                <partial name="_CharacterRow" model="character" />
                <td><a href="/Characters/Details/@character.Id">Details</a></td>
            </tr>
        }
    </tbody>
</table>